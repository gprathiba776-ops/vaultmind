# =============================
# VAULTMIND SERVER (PRIVATE)
# =============================
# Never expose these as VITE_* variables.

PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DEMO_MODE=false

# Lyzr Agent API
# Current documented headless invocation endpoint:
# https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_API_URL="https://agent-prod.studio.lyzr.ai/v3/inference/chat/"
LYZR_API_KEY=""
LYZR_AGENT_ID=""

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="vaultmind_memories"
QDRANT_VECTOR_SIZE=768

# Server-side embeddings
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSION=768

# Omi Integration App webhook adapter
# Keep the token server-side. Omi should POST transcript events to:
# POST /api/omi/webhook
OMI_WEBHOOK_TOKEN=""
OMI_API_KEY=""
OMI_API_BASE_URL="https://api.omi.me"

# =============================
# FRONTEND
# =============================
# Safe to expose: this contains no provider credential.
# Leave empty when frontend and server are served from the same origin.
VITE_API_BASE_URL=""

VAULTMIND_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
