{
  "name": "vaultmind",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Privacy-first governed agentic memory with voice input, Lyzr reasoning, Qdrant semantic memory, and observable SAVE/RETRIEVE/DENY/FORGET workflows.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server/index.mjs",
    "start": "npm run build && npm run server",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:server": "node --test tests/server/*.test.mjs",
    "eval:contracts": "node evals/run.mjs",
    "verify": "npm run doctor && npm run test && npm run lint && npm run lint:server && npm run format:check && npm run build",
    "lint:server": "eslint server tests evals --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60 tests/server/*.test.mjs",
    "test": "npm run test:server && npm run eval:contracts",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
